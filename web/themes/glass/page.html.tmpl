{{define "page" -}}
<div class="g-page">
  <div class="g-bg" aria-hidden="true"><div class="g-blob g-b1"></div><div class="g-blob g-b2"></div><div class="g-blob g-b3"></div></div>
  <div class="g-streaks" aria-hidden="true"></div>
  <div class="g-vignette" aria-hidden="true"></div>
  <div class="g-wrap">
    <main class="g-card">
      <div class="g-top">
        <div class="g-accent"><span class="g-line" aria-hidden="true"></span><span class="g-code">{{.Code}}</span></div>
        {{template "ep-langs" .}}
      </div>
      <h1 data-t="pages.{{.PageKey}}.title">{{.Title}}</h1>
      <p data-t="pages.{{.PageKey}}.description">{{.Description}}</p>
      {{- if .Closing}}
      <p data-t="pages.{{.PageKey}}.closing">{{.Closing}}</p>
      {{- end}}
      {{template "ep-until" .}}
      {{template "ep-actions" .}}
    </main>
    <div class="g-below">
      {{template "ep-menu" .}}
      {{template "ep-footer" .}}
    </div>
  </div>
</div>
{{- end}}
