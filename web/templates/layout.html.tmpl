{{- /*
  Shared layout. Each theme defines "page" (the body content) and places the
  partials ep-langs, ep-menu, ep-actions, ep-closing, ep-until and ep-footer
  where its design puts them. Translatable elements carry data-t="<key>" so
  i18n.js can swap their text in place. Optional texts are always rendered
  and carry `hidden` while empty; i18n.js toggles it on a language switch.
  A theme may redefine "ep-sep" (the footer separator, " · " by default).
  Pages are self-contained: .Style and .Script are the theme's CSS (with
  its fonts as data: URIs) and JS, built once at startup and allowed by
  their CSP hashes. The script sits at the end of body, so the DOM it
  enhances is complete when it runs.
*/ -}}
{{define "layout" -}}
<!DOCTYPE html>
<html lang="{{.Lang}}" data-code="{{.Code}}" data-page="{{.PageKey}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{.Code}} · {{.Title}}</title>
{{.Style}}
<script type="application/json" id="ep-texts">{{.TextsJSON}}</script>
</head>
<body class="ep ep-theme-{{.Theme}}">
{{template "page" .}}
{{.Script}}
</body>
</html>
{{end}}

{{- define "ep-langs"}}
{{- if .Langs}}<nav class="ep-langs" aria-label="{{call .T "ui.language"}}" data-t-label="ui.language">
{{- range .Langs}}<a href="{{.Href}}" hreflang="{{.Code}}" lang="{{.Code}}" data-lang="{{.Code}}"{{if .Current}} class="on" aria-current="true"{{end}}>{{.Label}}</a>{{end -}}
</nav>{{end}}
{{- end}}

{{- define "ep-menu"}}
{{- if .Links}}<nav class="ep-menu">
{{- range .Links}}<a href="{{.Href}}" data-link="{{.ID}}" data-t="link.{{.ID}}">{{.Label}}</a>{{end -}}
</nav>{{end}}
{{- end}}

{{- define "ep-actions"}}<div class="ep-actions"><a href="/" data-action="back" data-t="ui.back">{{call .T "ui.back"}}</a><a href="" data-action="reload" data-t="ui.reload">{{call .T "ui.reload"}}</a></div>
{{- end}}

{{- define "ep-closing"}}<p class="ep-closing" data-t="pages.{{.PageKey}}.closing"{{if not .Closing}} hidden{{end}}>{{.Closing}}</p>
{{- end}}

{{- define "ep-sep"}} · {{end}}

{{- define "ep-until"}}
{{- if .Until}}<p class="ep-until" data-until="{{.Until}}">{{.UntilText}}</p>{{end}}
{{- end}}

{{- define "ep-footer"}}
{{- if .Footer.Show}}<div class="ep-footer">
{{- with .Footer}}
{{- if .Name}}© {{.Year}} {{if .URL}}<a href="{{.URL}}">{{.Name}}</a>{{else}}{{.Name}}{{end}}{{end}}
{{- if and .Name .Version}}{{template "ep-sep"}}{{end}}
{{- if .Version}}v{{.Version}}{{end}}
{{- end -}}
</div>{{end}}
{{- end}}
